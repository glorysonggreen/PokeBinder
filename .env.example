# The Supabase URL and anon (publishable) key are in lib/config/supabase_config.dart.
# They are designed to be public and are protected by Row Level Security.
#
# The catalog import tools in tools/ read these as environment variables
# (they do not load this file), so export them in your terminal first.
#
# Never commit real secrets. Keep any secret or billable key here in a local
# .env file, which is git-ignored.
# SUPABASE_SECRET_KEY=never_put_this_in_a_client_app
# POKEMONTCG_API_KEY=put_your_key_here
